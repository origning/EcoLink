# EcoLink 服务端环境变量示例（复制为 .env 后按需修改，不要提交进 git）
#
# P1 只需要上面 ecosystem.config.cjs 里已有的几项；
# 下面这些留给 P2（登录）和 P4（备份）使用。

PORT=3000
ECOLINK_DATA_DIR=/opt/ecolink/data
ECOLINK_STATIC_DIR=/opt/ecolink/dist

# ---- P2 登录鉴权（届时启用，务必换成随机长串）----
# JWT_SECRET=change-me-to-a-long-random-string
# SESSION_DAYS=30

# ---- P4 每日备份（届时启用）----
# BACKUP_DIR=/opt/ecolink/backups
# BACKUP_KEEP_DAYS=30
